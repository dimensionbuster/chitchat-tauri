{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ChitChat",
  "version": "0.1.0",
  "identifier": "com.dimensionbuster.chitchat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build-only"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/blobs/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true,
    "category": "SocialNetworking",
    "shortDescription": "ChitChat 분산형 P2P 채팅"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCRDU3MjQ5MkM3QUQ2RkMKUldUODFub3NTWExWVzhFaUlMMVVGZ2NyNWMyVlE3ZDhwdWlvQ0tBV2dXdm5HR3ZVUDRwQ3plNjIK",
      "endpoints": [
        "https://github.com/dimensionbuster/chitchat-tauri/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}